#pragma kernel GenerateVertices
#include "FastNoiseLite.hlsl"

// STRICTLY ALIGNED TO 112 BYTES TO MATCH C#
struct GPUBiome
{
    float startThreshold;
    float baseHeightOffset;
    float amplitude;
    float frequency;
    
    int fractalType;
    int octaves;
    float lacunarity;
    float gain;
    
    float4 groundColor;
    float4 cliffColor;
    float4 noiseColor;
    
    int visualNoiseType;
    float visualFrequency;
    float noiseThreshold;
    float stretchX;
    
    float stretchY;
    float stretchZ;
    float metallic;
    float smoothness;

    float bumpStrength;
    float pad1;
    float pad2;
    float pad3;
};

struct GPUBiomePoint
{
    float3 position;
    int biomeIndex;
};

struct GPUVertexData
{
    float3 position;
    float positionPadding;
    float3 biomeIndices;
    float indicesPadding;
    float3 biomeWeights;
    float weightsPadding;
};

RWStructuredBuffer<GPUVertexData> _OutputVertices;
StructuredBuffer<float3> _InputDirections; 
StructuredBuffer<GPUBiome> _Biomes;
StructuredBuffer<GPUBiomePoint> _BiomePoints;

uint _VertexCount; 
uint _BiomeCount;
uint _BiomePointCount;
float _Radius;
float _BiomeBlendDistance;

int _EnableWarp;
float _WarpAmplitude;
float _WarpFrequency;
int _MacroSeed;

fnl_state GetBiomeNoiseState(GPUBiome biome, int seed)
{
    fnl_state state = fnlCreateState(seed);
    state.noise_type = FNL_NOISE_OPENSIMPLEX2;
    state.fractal_type = biome.fractalType;
    state.frequency = biome.frequency;
    state.octaves = biome.octaves;
    state.lacunarity = biome.lacunarity;
    state.gain = biome.gain;
    return state;
}

[numthreads(64, 1, 1)]
void GenerateVertices (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _VertexCount) return; 

    float3 unitVector = _InputDirections[id.x];
    float3 samplePos = unitVector * _Radius;
    float3 warpedDir = unitVector;
    
    if (_EnableWarp == 1)
    {
        fnl_state warpState = fnlCreateState(_MacroSeed + 1);
        warpState.domain_warp_type = FNL_DOMAIN_WARP_OPENSIMPLEX2;
        warpState.domain_warp_amp = _WarpAmplitude;
        warpState.frequency = _WarpFrequency;
        
        float wx = samplePos.x;
        float wy = samplePos.y;
        float wz = samplePos.z;
        fnlDomainWarp3D(warpState, wx, wy, wz);
        warpedDir = normalize(float3(wx, wy, wz));
    }

    // --- FIND 3 CLOSEST VORONOI POINTS ---
    float d1 = 3.402823466e+38F;
    float d2 = 3.402823466e+38F;
    float d3 = 3.402823466e+38F;
    uint idx1 = 0, idx2 = 0, idx3 = 0;

    for (uint i = 0; i < _BiomePointCount; i++)
    {
        float3 diff = warpedDir - _BiomePoints[i].position;
        float dist = length(diff); 

        if (dist < d1)
        {
            d3 = d2; idx3 = idx2;
            d2 = d1; idx2 = idx1;
            d1 = dist; idx1 = i;
        }
        else if (dist < d2)
        {
            d3 = d2; idx3 = idx2;
            d2 = dist; idx2 = i;
        }
        else if (dist < d3)
        {
            d3 = dist; idx3 = i;
        }
    }

    uint b1 = _BiomePoints[idx1].biomeIndex;
    uint b2 = _BiomePoints[idx2].biomeIndex;
    uint b3 = _BiomePoints[idx3].biomeIndex;

    // --- CALCULATE DISTANCE WEIGHTS (SMOOTHSTEP FIX) ---
    float w1 = 1.0;
    
    // Smoothstep curves the interpolation to 0.0 before reaching the limit, eliminating ridges
    float t2 = clamp((d2 - d1) / _BiomeBlendDistance, 0.0, 1.0);
    float w2 = smoothstep(1.0, 0.0, t2);

    float t3 = clamp((d3 - d1) / _BiomeBlendDistance, 0.0, 1.0);
    float w3 = smoothstep(1.0, 0.0, t3);

    float weightSum = w1 + w2 + w3;
    w1 /= weightSum;
    w2 /= weightSum;
    w3 /= weightSum;

    // --- BIOME OPTIMIZATION ---
    if (b2 == b1) { w1 += w2; w2 = 0.0; }
    if (b3 == b1) { w1 += w3; w3 = 0.0; }
    else if (b3 == b2) { w2 += w3; w3 = 0.0; }

    // --- EVALUATE HEIGHTS ---
    GPUBiome biomeA = _Biomes[b1];
    fnl_state stateA = GetBiomeNoiseState(biomeA, _MacroSeed);
    float noiseA = fnlGetNoise3D(stateA, samplePos.x, samplePos.y, samplePos.z);
    if (biomeA.fractalType == FNL_FRACTAL_RIDGED) noiseA = abs(noiseA);
    float heightA = biomeA.baseHeightOffset + (noiseA * biomeA.amplitude);

    float heightB = 0.0;
    if (w2 > 0.0)
    {
        GPUBiome biomeB = _Biomes[b2];
        fnl_state stateB = GetBiomeNoiseState(biomeB, _MacroSeed);
        float noiseB = fnlGetNoise3D(stateB, samplePos.x, samplePos.y, samplePos.z);
        if (biomeB.fractalType == FNL_FRACTAL_RIDGED) noiseB = abs(noiseB);
        heightB = biomeB.baseHeightOffset + (noiseB * biomeB.amplitude);
    }

    float heightC = 0.0;
    if (w3 > 0.0)
    {
        GPUBiome biomeC = _Biomes[b3];
        fnl_state stateC = GetBiomeNoiseState(biomeC, _MacroSeed);
        float noiseC = fnlGetNoise3D(stateC, samplePos.x, samplePos.y, samplePos.z);
        if (biomeC.fractalType == FNL_FRACTAL_RIDGED) noiseC = abs(noiseC);
        heightC = biomeC.baseHeightOffset + (noiseC * biomeC.amplitude);
    }

    // --- OUTPUT ---
    GPUVertexData output;
    output.position = unitVector * (_Radius + (heightA * w1) + (heightB * w2) + (heightC * w3));
    output.positionPadding = 0.0;
    
    output.biomeIndices = float3((float)b1, (float)b2, (float)b3);
    output.indicesPadding = 0.0;
    
    output.biomeWeights = float3(w1, w2, w3);
    output.weightsPadding = 0.0;

    _OutputVertices[id.x] = output;
}